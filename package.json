{
  "name": "charity-management",
  "version": "1.0.0",
  "description": "Charity donation management app for Android and Web",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev:android": "APP_ENV=development eas build --platform android --profile development",
    "build:dev:ios": "APP_ENV=development eas build --platform ios --profile development",
    "build:preview:android": "APP_ENV=staging eas build --platform android --profile preview",
    "build:preview:ios": "APP_ENV=staging eas build --platform ios --profile preview",
    "build:prod:android": "APP_ENV=production eas build --platform android --profile production-android",
    "build:prod:ios": "APP_ENV=production eas build --platform ios --profile production-ios",
    "build:prod:all": "APP_ENV=production eas build --platform all --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "update:dev": "APP_ENV=development eas update --branch development",
    "update:preview": "APP_ENV=staging eas update --branch preview",
    "update:prod": "APP_ENV=production eas update --branch production",
    "version:bump:patch": "npm version patch --no-git-tag-version",
    "version:bump:minor": "npm version minor --no-git-tag-version",
    "version:bump:major": "npm version major --no-git-tag-version",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:24177/git/Abdify/charity-management"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-navigation/bottom-tabs": "^7.8.5",
    "@react-navigation/native": "^7.1.20",
    "@react-navigation/native-stack": "^7.6.3",
    "babel-preset-expo": "^54.0.7",
    "expo": "^54.0.23",
    "expo-auth-session": "^7.0.8",
    "expo-file-system": "^19.0.17",
    "expo-status-bar": "^3.0.8",
    "expo-web-browser": "^15.0.9",
    "react": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@tsconfig/react-native": "^3.0.8",
    "@types/react": "^19.1.10",
    "@types/react-native": "^0.72.8",
    "typescript": "^5.9.3"
  }
}
